  "StructuredValue": {
   "description": "Derived, optional machine-readable reading of ``value_text``. Never replaces the source text.",
   "properties": {
    "kind": {
     "default": "text",
     "enum": [
      "scalar",
      "range",
      "bound",
      "set",
      "composite",
      "count",
      "ratio",
      "text",
      "boolean"
     ],
