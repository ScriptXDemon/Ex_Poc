# Copy to .env and fill in. .env is git-ignored: never commit keys.

# --- LLM endpoint -------------------------------------------------------------------------------
# Self-hosted OpenAI-compatible server (GPU farm, vLLM, SGLang, llama.cpp behind LiteLLM):
LLM_API_FLAVOR=openai
LLM_BASE_URL=https://your-llm-host/v1
LLM_API_KEY=your-key
MAIN_MODEL=qwen3.8:27b
VERIFIER_MODEL=qwen3.8:27b
VISION_MODEL=qwen3.8:27b
LLM_CONCURRENCY=1            # parallel requests per role; match the server's parallel slots
DOC_BUDGET_USD=0             # self-hosted endpoints report no cost ...
DOC_BUDGET_TOKENS=120000     # ... so cap a document by completion tokens instead (0 = no cap)
REQUEST_TIMEOUT_S=600
# LLM_STREAM=true            # default: on for self-hosted endpoints (survives proxy request timeouts)

# Or OpenRouter (pay per token, provider pinning, budget guard):
# LLM_API_FLAVOR=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# MAIN_MODEL=qwen/qwen3.8-27b
# VERIFIER_MODEL=openai/gpt-oss-120b
# VISION_MODEL=qwen/qwen3.8-27b
# OPENROUTER_BUDGET_USD=20
# DOC_BUDGET_USD=0.40

# --- pipeline knobs (defaults shown) -----------------------------------------------------------
# CHUNK_CONCURRENCY=6        # discovery chunks of one document in flight
# PDF_WINDOW_PAGES=40        # PDFs are parsed in windows of this many pages (no page limit)
# VISION_ENABLED=true        # transcribe image-only / image-heavy PDF pages with VISION_MODEL
# VISION_MAX_PAGES=40
